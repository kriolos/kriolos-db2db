# ==============================================================================
# DB2DB by ZettaIS - Ultra-Fast GraalVM Native Image Runtime
# ==============================================================================
FROM redhat/ubi9-minimal:latest

WORKDIR /work/

RUN chown 1001 /work \
    && chmod "g+rwX" /work \
    && chown 1001:root /work \
    && mkdir -p /work/conf /work/reports \
    && chown -R 1001:root /work

COPY --chown=1001:root db2db-web/target/*-runner /work/application
COPY --chown=1001:root db2db.conf /work/conf/db2db.conf

EXPOSE 8080
USER 1001

ENTRYPOINT ["./application", "-Dquarkus.http.host=0.0.0.0"]
